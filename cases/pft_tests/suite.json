{
  "name": "pft_tests",
  "description": "ATS-EcoSIM column tests with prescribed phenology over vegetation types and LAI, paired with standalone EcoSIM runs. Generate the pairs with --profile matched-start: both models then start at 1.00 C and the ATS bottom temperature is 274.429 K (initial + 0.28 K, EcoSIM deep source temperature). Provenance: templates/ and data/daymet_TaylorRiverCO_hourly.h5 (sha256 862ef83360774c4b2ce09160c93f4f543cedba89f7b4035f46f492a430a1fe58) come from ats-regression-tests 13_ecosim, branch agraus/smoke_tests, commit 44d2023.",
  "ats": {
    "template": "templates/ecosim_prescribed_phenology_evergreen_hourly.xml",
    "baseline": {"name": "bare_ground", "template": "templates/ecosim_freeze_thaw_hourly.xml"},
    "forcing": "data/daymet_TaylorRiverCO_hourly.h5",
    "data_dir": "data"
  },
  "name_pattern": "pft_{group}_lai{lai}",
  "sweep": [
    {"group": "deciduous", "pft": "tasp43", "vegetation_type": 22, "population": 0.1, "lai": [2, 4, 5]},
    {"group": "evergreen", "pft": "ndlf43", "vegetation_type": 19, "population": 0.1, "lai": [1, 2, 4, 5]},
    {"group": "grass",     "pft": "gr3s43", "vegetation_type": 77, "population": 300.0, "lai": [0.5, 1, 3]},
    {"group": "shrub",     "pft": "bush43", "vegetation_type": 68, "population": 1.0, "population_assumed": true, "lai": [0.5, 1, 3]}
  ],
  "xml_edits": [
    {"set": "state/evaluators/surface-vegetation_type/**/function-constant/value", "value": "{vegetation_type}"},
    {"set": "state/evaluators/surface-LAI/**/function-constant/value", "value": "{lai}"},
    {"set": "PKs/EcoSIM for ATS/engine input file", "value": "{pft_file}", "relative_to_run_dir": true, "max_length": 128}
  ],
  "profiles": {
    "dev-pk": [
      {"add_after": "PKs/EcoSIM for ATS/engine", "params": [
        {"name": "shared surface layer", "type": "bool", "value": false},
        {"name": "semi-implicit surface heat exchange", "type": "bool", "value": true}
      ]},
      {"set": "PKs/surface energy/source key", "value": "surface-ecosim_source_linearized"}
    ],
    "matched-start": [
      {"add_after": "PKs/EcoSIM for ATS/engine", "params": [
        {"name": "shared surface layer", "type": "bool", "value": false},
        {"name": "semi-implicit surface heat exchange", "type": "bool", "value": true}
      ]},
      {"set": "PKs/surface energy/source key", "value": "surface-ecosim_source_linearized"},
      {"set": "PKs/subsurface energy/initial conditions/value", "value": 274.15},
      {"set": "PKs/subsurface energy/boundary conditions/temperature/bottom/boundary temperature/function-constant/value", "value": 274.429}
    ]
  },
  "standalone": {
    "pft_file": "input_data/ecosim_pftpar_20261021.nc",
    "years": [1981, 1982],
    "layers": 19,
    "top_dz": 0.05,
    "particle_density": 2.66,
    "soil_albedo": 0.2,
    "history_fields": ["PSI_vr", "VSPore_vr", "rIceFLP_vr", "RootH2OUptake_vr"]
  },
  "compare": {
    "thresholds": {
      "transp_ratio": [0.25, 0.50],
      "transp_corr": [0.90, 0.70],
      "canopy_ratio": [0.25, 0.50],
      "canopy_corr": [0.90, 0.70],
      "snow_peak_ratio": [0.15, 0.30],
      "melt_out_days": [7.0, 21.0],
      "top_cell_rmse": [2.0, 5.0],
      "skin_rmse": [3.0, 6.0]
    }
  }
}
